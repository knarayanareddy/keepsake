# foundry build artefacts — lib/ is one `forge install` away from being committed by accident
/out/
/cache/
/lib/
# NB: broadcast/ is deliberately NOT ignored — HANDOVER.md treats committed deploy
# artifacts as provenance ("we did deploy this exact source"). Don't add it back.
# web/addresses.json IS committed on purpose: it is the zero-config handoff that turns the
# repo into a live demo link. script/Deploy.s.sol writes it; the UI reads it before it ever
# asks a human to paste anything. Keep it honest — if the contracts change, redeploy and
# recommit, or delete the file so the page falls back to the recorded preview instead.
# misc
node_modules/
.DS_Store
*.log
